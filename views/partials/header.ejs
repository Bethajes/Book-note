<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title ? title : 'My Bookshelf' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header Start -->
    <header class="site-header">
        <nav class="navbar">
            <div class="nav-container">
                <!-- Logo -->
                <div class="logo">
                    <a href="/">
                        <span class="logo-icon">📚</span>
                        <span class="logo-text">BookNest</span>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <!-- Navigation Links -->
                <ul class="nav-links" id="navLinks">
                    <li><a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">
                        <i class="fas fa-home"></i> Home
                    </a></li>
                    <li><a href="/new" class="<%= currentPage === 'add' ? 'active' : '' %>">
                        <i class="fas fa-plus-circle"></i> Add Book
                    </a></li>
                    <li><a href="/favorites" class="<%= currentPage === 'favorites' ? 'active' : '' %>">
                        <i class="fas fa-heart"></i> Favorites
                    </a></li>
                    <li><a href="/about" class="<%= currentPage === 'about' ? 'active' : '' %>">
                        <i class="fas fa-info-circle"></i> About
                    </a></li>
                </ul>

                <!-- Search Bar -->
                <div class="search-bar">
                    <form action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search books..." 
                               value="<%= locals.searchQuery || '' %>">
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </form>
                </div>

                <!-- User Stats (Optional) -->
                <div class="user-stats">
                    <i class="fas fa-book-open"></i>
                    <span class="stat-count"><%= locals.bookCount || 0 %></span>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">